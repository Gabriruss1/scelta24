# --- artefatti generati (si ricreano con i comandi) ---
out/
*.pdf.tmp

# --- proposte e analisi reali: NON vanno mai nel repo pubblico ---
# i dati veri si generano fuori dal repo (--out out) e si
# pubblicano su Cloudflare Pages. Se per errore una cartella reale finisce
# qui, il publish_check lo segnala ma il file resterebbe pubblico:
# meglio escludere tutto quello che non e' demo.
proposte/*/images/
proposte/*/*.pdf

# analisi: tieni solo la demo pubblica versionata (confronto-demo-bagno)
analisi/*
!analisi/confronto-demo-bagno/
!analisi/confronto-demo-bagno/**

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- sistema ---
.DS_Store
Thumbs.db
*.log

# --- tooling ---
.playwright-mcp/
_check/

# --- prova locale (generata da prova.py) ---
prova-output/
