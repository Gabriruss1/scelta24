<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>$TITOLO</title>
<meta name="description" content="$DESCRIZIONE">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0F1729">
<link rel="canonical" href="$URL_CANONICA">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,600;9..144,800&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/$CSS_VER/landing.css">
</head>
<body>
<a class="skip-link" href="#contenuto">Salta al contenuto</a>

<header class="topbar">
  <div class="topbar__inner">
    <a class="logo" href="index.html">Scelta<span>24</span></a>
    <nav>
      <a href="index.html">Torna alla pagina principale</a>
      <a href="chi-sono.html">Chi siamo</a>
      <a href="prezzi.html">Prezzi</a>
    </nav>
  </div>
</header>

<main id="contenuto">
<section class="hero">
  <div class="wrap">
    <p class="hero__kicker">$KICKER</p>
    <h1>$TITOLO_H1</h1>
    <p class="hero__lead">$LEAD</p>
    <div class="hero__azioni">
      <a class="btn btn--ghost" href="index.html">Torna a Scelta24</a>
    </div>
    <p class="hero__nota">$NOTA</p>
  </div>
</section>

<section class="sezione">
  <div class="wrap">
    <form action="https://formsubmit.co/russo.enterprise.biz@gmail.com" method="POST" id="contactForm" enctype="multipart/form-data">
      <input type="hidden" name="_subject" id="subjectField" value="Nuova richiesta dal sito Scelta24">
      <input type="hidden" name="_reply_to" id="replyToField" value="">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_next" value="https://gabriruss1.github.io/scelta24/grazie.html">
      <input type="hidden" name="servizio" id="servizioField" value="">
      <input type="text" name="_honey" style="display:none">

      <label for="nome">Nome e cognome *</label>
      <input type="text" id="nome" name="nome" required placeholder="Mario Rossi">

      <label for="email">Email *</label>
      <input type="email" id="email" name="email" required placeholder="mario@rossiserramenti.it">

      <label for="telefono">Telefono</label>
      <input type="tel" id="telefono" name="telefono" placeholder="+39 333 1234567">

      <label for="tipo_lavoro" id="tipoLavoroLabel" style="display:$TIPO_LAVORO_VIS">Tipo di lavoro</label>
      <select id="tipo_lavoro" name="tipo_lavoro" style="display:$TIPO_LAVORO_VIS">
        <option value="">Seleziona...</option>
        <option value="bagno">Bagno / ristrutturazione</option>
        <option value="serramenti">Serramenti / infissi</option>
        <option value="fotovoltaico">Fotovoltaico</option>
        <option value="climatizzazione">Climatizzazione</option>
        <option value="altro">Altro</option>
      </select>

      <label for="messaggio">Messaggio *</label>
      <textarea id="messaggio" name="messaggio" required>$MESSAGGIO_PLACEHOLDER</textarea>

      <label for="allegati">Allega preventivi o contratti (PDF)</label>
      <input type="file" id="allegati" name="allegati" accept=".pdf" multiple placeholder="Allega PDF">
      <p class="form-note" style="font-size:0.9rem;margin-top:4px;">Puoi allegare più PDF. Se hai più preventivi, mandali tutti insieme.</p>

      <button type="submit" class="btn btn--accent">Invia richiesta</button>
      <div class="form-status" id="formStatus"></div>
      <p class="form-note">$FORM_NOTE</p>
    </form>
  </div>
</section>

<section class="sezione sezione--scura">
  <div class="wrap">
    <h2 class="h2">Parliamone</h2>
    <p class="sottotitolo">Scrivici, ti rispondiamo entro 24 ore.</p>
    <div class="griglia griglia--3">
      <div class="card">
        <span class="card__num">Email</span>
        <h3>Contatto diretto</h3>
        <p><a href="mailto:russo.enterprise.biz@gmail.com" style="color:var(--amber);text-decoration:underline;">russo.enterprise.biz@gmail.com</a></p>
      </div>
      <div class="card">
        <span class="card__num">Orari</span>
        <h3>Quando scrivere</h3>
        <p>Lunedì – Venerdì, 9:00 – 18:00. Fuori orario, rispondiamo il primo giorno utile.</p>
      </div>
      <div class="card">
        <span class="card__num">Risposta</span>
        <h3>Entro 24 ore</h3>
        <p>Ogni richiesta riceve una conferma di ricezione automatica e poi il nostro seguito personale.</p>
      </div>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="wrap" style="max-width:720px;">
    <h2 class="h2" style="text-align:center;">Privacy e trattamento dati</h2>
    <p style="font-size:15px;color:var(--grey);margin-bottom:12px;margin-top:24px;">I dati raccolti tramite questo modulo sono utilizzati esclusivamente per rispondere alla tua richiesta. Non vengono ceduti a terzi. Il trattamento avviene ai sensi dell'art. 6.1.f GDPR (interesse legittimo) e dell'art. 6.1.a (consenso).</p>
    <p style="font-size:15px;color:var(--grey);">Hai il diritto di accedere, rettificare, cancellare i tuoi dati in qualsiasi momento, scrivendo a russo.enterprise.biz@gmail.com.</p>
  </div>
</section>

</main>

<footer class="pie">
  <div class="wrap">
    <div class="colonne">
      <div>
        <h4>Scelta24</h4>
        <ul>
          <li><a href="index.html">Confronta i tuoi preventivi</a></li>
          <li><a href="index.html#come-funziona">Come funziona</a></li>
          <li><a href="index.html#faq">Domande frequenti</a></li>
          <li><a href="chi-sono.html">Chi siamo</a></li>
          <li><a href="prezzi.html">Prezzi e pagamento</a></li>
          <li><a href="termini.html">Termini e condizioni</a></li>
        </ul>
      </div>
      <div>
        <h4>Per le aziende</h4>
        <ul>
          <li><a href="$URL_AZIENDE">Preventivi24: presenta meglio i tuoi preventivi</a></li>
          <li><a href="$URL_AZIENDE/contatti.html">Contatti Preventivi24</a></li>
        </ul>
      </div>
    </div>
    <p class="nota">Scelta24 &eacute; un servizio di <a href="$URL_AZIENDE">Preventivi24</a>. I documenti inviati non vengono pubblicati ne' usati per addestrare modelli.</p>
  </div>
</footer>

<script>
(function(){
  var p=new URLSearchParams(location.search);
  if(p.get('servizio')==='confronto'){
    var s=document.getElementById('subjectField'); if(s) s.value='Confronto preventivi — Scelta24';
    var sv=document.getElementById('servizioField'); if(sv) sv.value='confronto';
    var h=document.getElementById('heroTitle'); if(h) h.textContent='Invia i tuoi preventivi';
    var l=document.getElementById('heroLead'); if(l) l.textContent='Mandaci i preventivi o i contratti che vuoi confrontare. Li analizziamo riga per riga e ti inviamo il verdetto, controllato da una persona. Gratis.';
    var tl=document.getElementById('tipoLavoroLabel'); if(tl) tl.style.display='block';
    var ts=document.getElementById('tipo_lavoro'); if(ts) ts.style.display='block';
    var m=document.getElementById('messaggio'); if(m) m.placeholder='Descrivi il lavoro e indica quanti preventivi vuoi confrontare. Allega i PDF rispondendo alla mail di conferma oppure scrivici a russo.enterprise.biz@gmail.com con i file in allegato.';
    var fn=document.querySelector('.form-note'); if(fn) fn.textContent='Gratis. I documenti non vengono pubblicati ne\' usati per addestrare modelli e vengono eliminati dopo la consegna.';
  } else if(p.get('servizio')==='analisi-completa'){
    var s=document.getElementById('subjectField'); if(s) s.value='Analisi completa preventivi — Scelta24';
    var sv=document.getElementById('servizioField'); if(sv) sv.value='analisi-completa';
    var h=document.getElementById('heroTitle'); if(h) h.textContent='Richiedi l\'analisi completa';
    var l=document.getElementById('heroLead'); if(l) l.textContent='Analisi completa dei tuoi preventivi e contratti: costo reale, voci mancanti, semafori di rischio e domande da fare alle aziende. 39 €, controllato da una persona prima di arrivarti.';
    var tl=document.getElementById('tipoLavoroLabel'); if(tl) tl.style.display='block';
    var ts=document.getElementById('tipo_lavoro'); if(ts) ts.style.display='block';
    var m=document.getElementById('messaggio'); if(m) m.placeholder='Descrivi il lavoro da analizzare. Allega i PDF dei preventivi e dei contratti che vuoi confrontare.';
    var fn=document.querySelector('.form-note'); if(fn) fn.textContent='Analisi completa a pagamento (39 €). I documenti non vengono pubblicati ne\' usati per addestrare modelli e vengono eliminati dopo la consegna.';
  }
})();

document.getElementById('contactForm').addEventListener('submit', function(){
  var email=document.getElementById('email');
  var reply=document.getElementById('replyToField');
  if(email && reply) reply.value=email.value;
});
</script>

<a class="torna-su" href="#" aria-label="Torna su">&#8593;</a>
<script>
  (function(){
    var btn=document.querySelector('.torna-su');
    if(!btn) return;
    window.addEventListener('scroll', function(){
      if(window.scrollY>300) btn.classList.add('torna-su--visibile');
      else btn.classList.remove('torna-su--visibile');
    });
    btn.addEventListener('click', function(e){
      e.preventDefault(); window.scrollTo({top:0, behavior:'smooth'});
    });
  })();
</script>
</body>
</html>
