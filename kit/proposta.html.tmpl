<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>$TITOLO</title>
<meta name="description" content="$DESCRIZIONE">
<meta name="robots" content="$ROBOTS">
<meta name="theme-color" content="$COLORE_TEMA">
<link rel="canonical" href="$URL_CANONICA">

<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:site_name" content="$NOME_AZIENDA">
<meta property="og:title" content="$OG_TITOLO">
<meta property="og:description" content="$OG_DESCRIZIONE">
<meta property="og:url" content="$URL_CANONICA">
<meta property="og:image" content="$OG_IMMAGINE">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="$OG_TITOLO">
<meta name="twitter:description" content="$OG_DESCRIZIONE">
<meta name="twitter:image" content="$OG_IMMAGINE">

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>$ICONA</text></svg>">
<style>$BRAND_CSS</style>
<link rel="stylesheet" href="$CSS_HREF">
$PIANO_SCRIPT
</head>
<body>
<a class="skip-link" href="#contenuto">Salta al contenuto</a>

<header class="topbar">
  <div class="topbar__inner">
    <div class="brand">
      $LOGO
      <div>
        <div class="brand__nome">$NOME_AZIENDA</div>
        <div class="brand__meta">$SEDE_AZIENDA</div>
      </div>
    </div>
    <div class="topbar__ref">
      <b>$ETICHETTA_RIF</b>
      $RIFERIMENTO
    </div>
  </div>
</header>

<main id="contenuto">
$CORPO
</main>

$BARRA_SCELTA

<footer class="pie">
  <p>$NOTA_PIE</p>
  <p class="pie__note">Documento riservato. Generato il $DATA_GENERAZIONE. Riferimento $RIFERIMENTO.</p>
</footer>

<script src="$JS_HREF" defer></script>
</body>
</html>
